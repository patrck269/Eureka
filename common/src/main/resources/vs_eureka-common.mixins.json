{
  "required": true,
  "package": "org.valkyrienskies.eureka.mixin",
  "compatibilityLevel": "JAVA_17",
  "plugin": "org.valkyrienskies.eureka.mixin.EurekaMixinConfigPlugin",
  "mixins": [
    "MixinEntityShipDeckLanding",
    "MixinEntitySectionStorageSafe",
    "MixinMinecraftServerShipDeckWeld",
    "MixinServerLevelShipDeckWeld",
    "compat.MixinImmersiveAircraftVehicle",
    "compat.MixinSimplePlanesVehicle",
    "compat.MixinImmersiveVehiclesVehicle",
    "compat.MixinWrapperWorldShipCollision",
    "MixinWariumArrowTickOnShip",
    "MixinWariumSkipShipyardMove",
    "compat.MixinWariumHugeBulletHit",
    "compat.MixinWariumHvParticleHit",
    "compat.MixinWariumHugeBulletEntityHit"
  ],
  "client": [
    "client.MixinClientLevelShipDeckWeld",
    "client.MixinMinecraftShipDeckWeld",
    "client.PlayerEntityModelMixin"
  ],
  "server": [
    "compat.MixinDhProxyUtilServer"
  ],
  "injectors": {
    "defaultRequire": 1
  },
  "minVersion": "0.8"
}
